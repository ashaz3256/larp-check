# Copy this file to .env.local and fill in ONE key (or both).
# Free option: get a key at https://console.groq.com
GROQ_API_KEY=
# Paid option, better roasts and can read pictures: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the Groq models (defaults: llama-3.3-70b-versatile for text, qwen/qwen3.8-27b for pictures)
GROQ_MODEL=
GROQ_VISION_MODEL=
# Your live address, e.g. https://larp-check.vercel.app (makes share cards work)
NEXT_PUBLIC_SITE_URL=
# Checks allowed per visitor per day
DAILY_LIMIT=5
